{
  "name": "umamusume-sp-calc",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "description": "ウマ娘 取得可能スキル全習得の理論必要SP算出ツール",
  "scripts": {
    "extract": "node scripts/extract_mdb.mjs",
    "patch:activation": "node scripts/patch_skill_activation.mjs",
    "relink-skills": "node scripts/relink_skills.mjs",
    "test": "node scripts/test_sp.mjs && node scripts/test_skill_activation.mjs && node scripts/test_copy_included_skills.mjs && node scripts/test_design_snapshot.mjs",
    "verify": "node scripts/verify_data.mjs",
    "bind-priority": "node scripts/bind_priority.mjs",
    "render:priority-supports": "node scripts/render_priority_supports.mjs",
    "extract:events": "node scripts/extract_support_events.mjs",
    "compare:events": "node scripts/compare_events_golden.mjs",
    "apply:events": "node scripts/apply_extracted_events.mjs",
    "merge-support-events": "node scripts/merge_support_events.mjs",
    "reclassify-support-events": "node scripts/reclassify_support_events.mjs",
    "assets:extract": "node scripts/run_extract_card_assets.mjs",
    "assets:import": "node scripts/import_card_assets.mjs",
    "samples:vertical-v3": "node scripts/run_make_vertical_support_v3.mjs",
    "samples:vertical-v4": "node scripts/run_make_vertical_support_v4.mjs",
    "samples:trim": "node scripts/run_make_trim_support_samples.mjs",
    "serve": "npx --yes serve . -l 8080"
  }
}
